# ============================================================================
# Upstream Paperclip (do NOT remove — required to boot)
# ============================================================================
DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ============================================================================
# Koenig customizations (see .env.example.koenig for full descriptions)
# ============================================================================

# LLM routing (the only LLM key strictly required for V1)
OPENROUTER_API_KEY=sk-or-v1-XXXXX_PASTE_REAL_KEY_HERE_XXXXX
XAI_API_KEY=xai-XXXXX_PASTE_REAL_KEY_HERE_XXXXX

# Research stack (free tiers OK)
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Content pipeline
CARTESIA_API_KEY=
RESEND_API_KEY=

# Koenig AI Academy product (the agency publishes to this)
ACADEMY_AGENT_API_KEY=
NEXT_PUBLIC_ACADEMY_CONVEX_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=koenig-academy-media
CLOUDFLARE_R2_ENDPOINT=

# Observability (Langfuse self-host on localhost:3200)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3200

# Phase 3 (Teams huddle) — leave blank for V1
RECALL_API_KEY=
ASSEMBLYAI_API_KEY=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Watchdog alerting (Phase 2 — wire to Slack/Teams/Email)
WATCHDOG_ALERT_SLACK_WEBHOOK=
WATCHDOG_ALERT_EMAIL_TO=vardaan97@gmail.com

# Publish pipeline (scripts/publish-action.sh + cleanup-stale-publish-states.sh)
# Canonical Learnova Academy company UUID for Paperclip API calls:
# PAPERCLIP_COMPANY_ID=2a77f89b-33f0-4133-a20c-77ddaac5e744
# COMPANY_ID=2a77f89b-33f0-4133-a20c-77ddaac5e744
# GitHub PAT with repo + workflow scopes on Koenig-Solutions-Private-Limited/learnovaBeast:
# GH_PAT_DISPATCH=ghp_XXXXX_PASTE_REAL_TOKEN_HERE_XXXXX
# Board bearer token for publish-action Paperclip API auth (already used elsewhere):
# PAPERCLIP_BOARD_TOKEN=pcb_XXXXX_PASTE_REAL_TOKEN_HERE_XXXXX

# Google Search Console API (KOEA-708 — required for weekly SC pull KOEA-706)
# Option A: Service-account JSON (preferred — no token refresh needed)
#   GSC_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...@...iam.gserviceaccount.com",...}'
# Option B: OAuth 2.0 client (if service-account not possible)
#   GSC_CLIENT_ID=
#   GSC_CLIENT_SECRET=
#   GSC_REFRESH_TOKEN=
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=https://academy.kspl.tech/
